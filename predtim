<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Prediksi Tim</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at top, #1d4ed8, transparent 40%),
        linear-gradient(135deg, #050816, #111827);

      color: white;

      display: flex;
      justify-content: center;
      align-items: center;

      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 900px;

      background: rgba(15, 23, 42, 0.95);

      border: 1px solid rgba(255,255,255,0.1);

      border-radius: 25px;

      padding: 35px;

      box-shadow:
        0 25px 70px rgba(0,0,0,0.5);
    }

    .header {
      text-align: center;
      margin-bottom: 35px;
    }

    .header h1 {
      font-size: 36px;
      margin-bottom: 10px;

      background: linear-gradient(
        90deg,
        #38bdf8,
        #6366f1
      );

      -webkit-background-clip: text;
      color: transparent;
    }

    .header p {
      color: #94a3b8;
    }

    .teams {
      display: grid;

      grid-template-columns:
        1fr 80px 1fr;

      gap: 20px;

      align-items: center;
    }

    .team {
      background: #1e293b;

      border-radius: 20px;

      padding: 25px;

      text-align: center;

      border: 1px solid #334155;

      transition: 0.3s;
    }

    .team:hover {
      transform: translateY(-5px);

      border-color: #38bdf8;

      box-shadow:
        0 10px 30px rgba(56,189,248,0.15);
    }

    .team input {
      width: 100%;

      background: #0f172a;

      border: 1px solid #475569;

      color: white;

      border-radius: 12px;

      padding: 13px;

      text-align: center;

      font-size: 20px;

      font-weight: bold;

      outline: none;
    }

    .team input:focus {
      border-color: #38bdf8;
    }

    .percentage {
      margin-top: 25px;
    }

    .percentage-value {
      font-size: 45px;

      font-weight: bold;

      margin-bottom: 12px;
    }

    .blue {
      color: #38bdf8;
    }

    .red {
      color: #fb7185;
    }

    .bar {
      width: 100%;

      height: 14px;

      background: #020617;

      border-radius: 20px;

      overflow: hidden;
    }

    .bar-fill {
      height: 100%;

      border-radius: 20px;

      transition: width 0.3s;
    }

    .bar-blue {
      background:
        linear-gradient(
          90deg,
          #0ea5e9,
          #38bdf8
        );
    }

    .bar-red {
      background:
        linear-gradient(
          90deg,
          #f43f5e,
          #fb7185
        );
    }

    .vs {
      width: 65px;

      height: 65px;

      border-radius: 50%;

      background:
        linear-gradient(
          135deg,
          #2563eb,
          #7c3aed
        );

      display: flex;

      justify-content: center;
      align-items: center;

      font-weight: bold;

      margin: auto;

      box-shadow:
        0 0 30px rgba(99,102,241,0.5);
    }

    .controls {
      margin-top: 35px;

      background: #111827;

      padding: 25px;

      border-radius: 20px;

      border: 1px solid #1e293b;
    }

    .controls h2 {
      font-size: 19px;

      margin-bottom: 25px;
    }

    .slider {
      margin-bottom: 25px;
    }

    .slider-header {
      display: flex;

      justify-content: space-between;

      margin-bottom: 10px;

      color: #cbd5e1;
    }

    input[type="range"] {
      width: 100%;

      accent-color: #38bdf8;

      cursor: pointer;
    }

    .result {
      margin-top: 30px;

      text-align: center;

      padding: 30px;

      border-radius: 20px;

      background:
        linear-gradient(
          135deg,
          rgba(37,99,235,0.15),
          rgba(124,58,237,0.15)
        );

      border: 1px solid rgba(99,102,241,0.3);
    }

    .result-title {
      font-size: 13px;

      color: #94a3b8;

      letter-spacing: 2px;
    }

    .winner {
      font-size: 32px;

      font-weight: bold;

      margin-top: 12px;

      color: #38bdf8;
    }

    .confidence {
      margin-top: 10px;

      color: #cbd5e1;
    }

    button {
      margin-top: 20px;

      border: none;

      background: #334155;

      color: white;

      padding: 12px 25px;

      border-radius: 10px;

      cursor: pointer;

      font-weight: bold;
    }

    button:hover {
      background: #475569;
    }

    @media (max-width: 650px) {

      .container {
        padding: 20px;
      }

      .header h1 {
        font-size: 28px;
      }

      .teams {
        grid-template-columns: 1fr;
      }

      .vs {
        margin: 5px auto;
      }

    }
  </style>
</head>

<body>

  <div class="container">

    <div class="header">
      <h1>⚡ Prediksi Pertandingan</h1>

      <p>
        Tentukan nama tim dan peluang kemenangan
      </p>
    </div>


    <!-- TIM -->

    <div class="teams">

      <div class="team">

        <input
          id="team1"
          type="text"
          value="Tim 1"
          maxlength="20"
        >

        <div class="percentage">

          <div
            id="percent1"
            class="percentage-value blue"
          >
            50%
          </div>

          <div class="bar">

            <div
              id="bar1"
              class="bar-fill bar-blue"
              style="width:50%"
            ></div>

          </div>

        </div>

      </div>


      <div class="vs">
        VS
      </div>


      <div class="team">

        <input
          id="team2"
          type="text"
          value="Tim 2"
          maxlength="20"
        >

        <div class="percentage">

          <div
            id="percent2"
            class="percentage-value red"
          >
            50%
          </div>

          <div class="bar">

            <div
              id="bar2"
              class="bar-fill bar-red"
              style="width:50%"
            ></div>

          </div>

        </div>

      </div>

    </div>


    <!-- PENGATURAN -->

    <div class="controls">

      <h2>
        🎯 Atur Persentase Kemenangan
      </h2>


      <div class="slider">

        <div class="slider-header">

          <span id="nameLabel1">
            Tim 1
          </span>

          <strong id="value1">
            50%
          </strong>

        </div>

        <input
          id="slider1"
          type="range"
          min="0"
          max="100"
          value="50"
        >

      </div>


      <div class="slider">

        <div class="slider-header">

          <span id="nameLabel2">
            Tim 2
          </span>

          <strong id="value2">
            50%
          </strong>

        </div>

        <input
          id="slider2"
          type="range"
          min="0"
          max="100"
          value="50"
        >

      </div>

    </div>


    <!-- HASIL -->

    <div class="result">

      <div class="result-title">
        HASIL PREDIKSI
      </div>

      <div
        id="winner"
        class="winner"
      >
        🏆 Tim 1
      </div>

      <div
        id="confidence"
        class="confidence"
      >
        Peluang kemenangan: 50%
      </div>

      <button onclick="resetData()">
        Reset
      </button>

    </div>

  </div>


  <script>

    const team1 =
      document.getElementById("team1");

    const team2 =
      document.getElementById("team2");

    const slider1 =
      document.getElementById("slider1");

    const slider2 =
      document.getElementById("slider2");


    function update(changed) {

      let p1 =
        parseInt(slider1.value);

      let p2 =
        parseInt(slider2.value);


      /*
        Total persentase selalu 100%.
      */

      if (changed === 1) {

        p2 = 100 - p1;

        slider2.value = p2;

      } else {

        p1 = 100 - p2;

        slider1.value = p1;

      }


      document.getElementById("percent1")
        .textContent = p1 + "%";

      document.getElementById("percent2")
        .textContent = p2 + "%";


      document.getElementById("value1")
        .textContent = p1 + "%";

      document.getElementById("value2")
        .textContent = p2 + "%";


      document.getElementById("bar1")
        .style.width = p1 + "%";

      document.getElementById("bar2")
        .style.width = p2 + "%";


      const name1 =
        team1.value.trim() || "Tim 1";

      const name2 =
        team2.value.trim() || "Tim 2";


      document.getElementById("nameLabel1")
        .textContent = name1;

      document.getElementById("nameLabel2")
        .textContent = name2;


      const winner =
        document.getElementById("winner");

      const confidence =
        document.getElementById("confidence");


      if (p1 > p2) {

        winner.textContent =
          "🏆 " + name1;

        confidence.textContent =
          "Peluang kemenangan: " + p1 + "%";

      }

      else if (p2 > p1) {

        winner.textContent =
          "🏆 " + name2;

        confidence.textContent =
          "Peluang kemenangan: " + p2 + "%";

      }

      else {

        winner.textContent =
          "⚔️ Seimbang";

        confidence.textContent =
          "Kedua tim memiliki peluang 50%";

      }

    }


    slider1.addEventListener(
      "input",
      () => update(1)
    );


    slider2.addEventListener(
      "input",
      () => update(2)
    );


    team1.addEventListener(
      "input",
      () => update(1)
    );


    team2.addEventListener(
      "input",
      () => update(1)
    );


    function resetData() {

      team1.value = "Tim 1";

      team2.value = "Tim 2";

      slider1.value = 50;

      slider2.value = 50;

      update(1);

    }


    update(1);

  </script>

</body>
</html>
